# Copy to .env and fill from Supabase Dashboard → Project Settings → API
# Cursor: Supabase MCP can supply project URL and anon/publishable keys (get_project_url, get_publishable_keys).
SUPABASE_URL=
# Legacy JWT anon key (recommended name for most @supabase/supabase-js usage)
SUPABASE_ANON_KEY=
# Or use a modern publishable key instead of SUPABASE_ANON_KEY (pick one branch)
# SUPABASE_PUBLISHABLE_KEY=
# Server-only — never commit — copy from Dashboard (not exposed via publishable MCP)
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this API (no trailing slash). Used for Google OAuth redirect:
# ${PUBLIC_BACKEND_URL}/api/auth/oauth/google/callback
# In Supabase Dashboard → Authentication → URL configuration, add that URL and (for native iOS) costa://oauth if required.
PUBLIC_BACKEND_URL=http://localhost:3222

# Native Google OAuth: if 302 to costa:// is blocked in the sign-in web view, set to 1 to return
# 200 HTML that runs location.replace('costa://…#encodeURIComponent(JSON)') instead.
# OAUTH_NATIVE_HTML_COMPLETE=0

# GPT-4o vision bill parsing (/api/cost/from-bill)
OPENAI_API_KEY=
